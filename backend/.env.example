# =================================================================
# CyberCrimePredict - Backend Environment Configuration
# Demonstration Environment — Synthetic Data
# =================================================================

# Server Port and Host
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production
DEBUG=False

# Secret Keys for Session and JWT Auth
SECRET_KEY=cybercrime_predict_production_secret_key_change_me_in_prod_2026
JWT_SECRET=cybercrime_jwt_secure_token_key_change_in_production_2026

# Primary Production Database (PostgreSQL)
# Format: postgresql://username:password@hostname:5432/database_name
# If omitted or unreachable, backend gracefully falls back to local SQLite (cybercrime.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybercrimepredict

# CORS Configuration
# Comma-separated list of allowed origins (e.g. deployed frontend domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Power BI Embedded Configuration (Leave blank if using file export)
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=

# Optional: External LLM & Vector Settings (Default uses built-in TF-IDF semantic vector store)
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
